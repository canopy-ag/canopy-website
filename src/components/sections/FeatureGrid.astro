---
/**
 * FeatureGrid: a responsive grid of glass cards.
 *
 * Feed it an `items` array. A card links out when `href` is set, and shows a
 * small pill when `tag` is set. Kicker is an optional label above the title
 * (for example a numbered step).
 */
interface Item {
  title: string;
  body: string;
  href?: string;
  tag?: string;
  tagTone?: 'live' | 'soon' | 'neutral';
  kicker?: string;
}

interface Props {
  items: Item[];
  columns?: 2 | 3;
}

const { items, columns = 3 } = Astro.props;
---

<ul class:list={['fgrid', `fgrid--${columns}`]}>
  {items.map((item) => {
    const inner = (
      <>
        {(item.kicker || item.tag) && (
          <div class="fcard__meta">
            {item.kicker && <span class="fcard__kicker">{item.kicker}</span>}
            {item.tag && <span class:list={['fcard__tag', `fcard__tag--${item.tagTone ?? 'neutral'}`]}>{item.tag}</span>}
          </div>
        )}
        <h3 class="fcard__title">{item.title}</h3>
        <p class="fcard__body">{item.body}</p>
        {item.href && (
          <span class="fcard__link">
            Learn more <span aria-hidden="true">&rarr;</span>
          </span>
        )}
      </>
    );
    return (
      <li>
        {item.href
          ? <a class="fcard fcard--link glass" href={item.href}>{inner}</a>
          : <div class="fcard glass">{inner}</div>}
      </li>
    );
  })}
</ul>

<style>
  .fgrid {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 1.25rem;
  }
  .fgrid--2 { grid-template-columns: repeat(2, 1fr); }
  .fgrid--3 { grid-template-columns: repeat(3, 1fr); }
  @media (max-width: 62rem) {
    .fgrid--3 { grid-template-columns: repeat(2, 1fr); }
  }
  @media (max-width: 40rem) {
    .fgrid--2, .fgrid--3 { grid-template-columns: 1fr; }
  }
  .fgrid > li { display: flex; }

  .fcard {
    display: flex;
    flex-direction: column;
    width: 100%;
    border-radius: 1rem;
    padding: 1.6rem;
    transition: transform 0.2s ease, border-color 0.2s ease;
  }
  .fcard--link {
    text-decoration: none;
    color: inherit;
  }
  .fcard--link:hover {
    transform: translateY(-2px);
  }

  .fcard__meta {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    margin-bottom: 0.85rem;
  }
  .fcard__kicker {
    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--canopy-text-secondary, rgba(255, 255, 255, 0.55));
    font-variant-numeric: tabular-nums;
  }
  .fcard__tag {
    font-size: 0.65rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    padding: 0.25rem 0.55rem;
    border-radius: 6px;
  }
  .fcard__tag--live { color: var(--canopy-green-light, #4ade80); background: rgba(34, 197, 94, 0.14); }
  .fcard__tag--soon { color: var(--canopy-blue, #00d4ff); background: rgba(0, 212, 255, 0.12); }
  .fcard__tag--neutral { color: rgba(255, 255, 255, 0.7); background: rgba(255, 255, 255, 0.08); }

  .fcard__title {
    margin: 0 0 0.55rem;
    font-size: 1.2rem;
    font-weight: 600;
    color: var(--canopy-text-primary, #fff);
  }
  .fcard__body {
    margin: 0;
    font-size: 0.96rem;
    line-height: 1.6;
    color: var(--canopy-text-secondary, rgba(255, 255, 255, 0.66));
  }
  .fcard__link {
    margin-top: 1.1rem;
    font-size: 0.9rem;
    font-weight: 600;
    color: var(--canopy-blue, #00d4ff);
  }
</style>

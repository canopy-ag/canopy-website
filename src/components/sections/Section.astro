---
/**
 * Section: the workhorse layout wrapper for marketing pages.
 *
 * Provides consistent vertical rhythm, a centered max-width container, and an
 * optional header (eyebrow, title, intro). Body goes in the default slot.
 * Only brand tokens + rem here so pages stay on the design system.
 */
interface Props {
  id?: string;
  eyebrow?: string;
  title?: string;
  intro?: string;
  align?: 'left' | 'center';
  width?: 'narrow' | 'default' | 'wide';
  tone?: 'default' | 'panel';
}

const {
  id,
  eyebrow,
  title,
  intro,
  align = 'left',
  width = 'default',
  tone = 'default',
} = Astro.props;

const hasHeader = Boolean(eyebrow || title || intro);
---

<section id={id} class:list={['sec', `sec--${tone}`]}>
  <div class:list={['sec__inner', `sec__inner--${width}`]}>
    {hasHeader && (
      <header class:list={['sec__head', align === 'center' && 'sec__head--center']}>
        {eyebrow && <p class="sec__eyebrow">{eyebrow}</p>}
        {title && <h2 class="sec__title">{title}</h2>}
        {intro && <p class="sec__intro">{intro}</p>}
      </header>
    )}
    <slot />
  </div>
</section>

<style>
  .sec {
    padding-block: clamp(3.5rem, 8vw, 6rem);
  }
  .sec--panel {
    background: color-mix(in srgb, var(--canopy-card, #111d2f) 55%, transparent);
    border-block: 1px solid rgba(255, 255, 255, 0.08);
  }

  .sec__inner {
    margin-inline: auto;
    padding-inline: clamp(1.25rem, 4vw, 2.75rem);
    width: 100%;
  }
  .sec__inner--narrow { max-width: 48rem; }
  .sec__inner--default { max-width: 72rem; }
  .sec__inner--wide { max-width: 80rem; }

  .sec__head {
    max-width: 46rem;
    margin-bottom: clamp(2rem, 4vw, 3rem);
  }
  .sec__head--center {
    margin-inline: auto;
    text-align: center;
  }

  .sec__eyebrow {
    margin: 0 0 0.9rem;
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--canopy-blue, #00d4ff);
  }

  .sec__title {
    margin: 0;
    font-size: clamp(1.75rem, 3.4vw, 2.6rem);
    line-height: 1.12;
    letter-spacing: -0.015em;
    font-weight: 700;
    color: var(--canopy-text-primary, #fff);
    text-wrap: balance;
  }

  .sec__intro {
    margin: 1rem 0 0;
    font-size: clamp(1.03rem, 1.4vw, 1.2rem);
    line-height: 1.6;
    color: var(--canopy-text-secondary, rgba(255, 255, 255, 0.68));
  }
  .sec__head--center .sec__intro {
    margin-inline: auto;
  }
</style>

---
/**
 * CtaSection: the closing call to action.
 *
 * Centered heading, optional body, a primary demo action, and an optional
 * secondary link. Uses the site's green wash for the closing moment.
 */
import DemoForm from '~/components/DemoForm';

interface Props {
  title: string;
  body?: string;
  demoLabel?: string;
  secondaryHref?: string;
  secondaryLabel?: string;
}

const {
  title,
  body,
  demoLabel = 'Request a demo',
  secondaryHref,
  secondaryLabel,
} = Astro.props;
---

<section class="cta">
  <div class="cta__wash" aria-hidden="true"></div>
  <div class="cta__inner">
    <h2 class="cta__title">{title}</h2>
    {body && <p class="cta__body">{body}</p>}
    <div class="cta__actions">
      <DemoForm client:load label={demoLabel} />
      {secondaryHref && secondaryLabel && (
        <a href={secondaryHref} class="btn-secondary text-lg px-8 py-4">{secondaryLabel}</a>
      )}
    </div>
  </div>
</section>

<style>
  .cta {
    position: relative;
    overflow: hidden;
    isolation: isolate;
    padding-block: clamp(4rem, 9vw, 6.5rem);
  }
  .cta__wash {
    position: absolute;
    inset: 0;
    z-index: 0;
    background: linear-gradient(90deg, rgba(34, 197, 94, 0.1), transparent 45%, rgba(34, 197, 94, 0.1));
    pointer-events: none;
  }
  .cta__inner {
    position: relative;
    z-index: 1;
    max-width: 44rem;
    margin-inline: auto;
    padding-inline: clamp(1.25rem, 4vw, 2.75rem);
    text-align: center;
  }
  .cta__title {
    margin: 0 0 1rem;
    font-size: clamp(1.9rem, 4vw, 2.9rem);
    line-height: 1.1;
    letter-spacing: -0.015em;
    font-weight: 700;
    color: var(--canopy-text-primary, #fff);
    text-wrap: balance;
  }
  .cta__body {
    margin: 0 auto 2rem;
    max-width: 34rem;
    font-size: clamp(1.03rem, 1.4vw, 1.18rem);
    line-height: 1.55;
    color: var(--canopy-text-secondary, rgba(255, 255, 255, 0.66));
  }
  .cta__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
    justify-content: center;
    align-items: center;
  }
</style>

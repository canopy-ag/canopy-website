---
/**
 * One product screenshot, served from cdn.canopy.ag.
 *
 * ## Why this is not `<Image />`
 *
 * `astro:assets` optimizes a remote image by fetching it at build time, and a
 * 404 there takes the whole build down. The bucket is no longer empty, since
 * the first publish landed 2026-09-18, but every id this page renders is still
 * absent, because all six are `demo` tier and blocked on the Canopy Creek
 * Farms tenant. A plain `<img>` defers the fetch to the browser, which is what
 * lets the page exist while that is true.
 *
 * The CDN host is authorized in `astro.config.mjs`, so switching to `<Image />`
 * is a component change and not a config one. The precondition is not "assets
 * exist" but "every id in `PRODUCT_SECTIONS` resolves". Switching while one
 * still 404s trades a graceful placeholder for a red build.
 *
 * ## Absent images are a designed state, not an accident
 *
 * Three things hold the layout still and keep a missing screenshot from
 * looking like a bug:
 *
 * 1. The frame reserves its aspect ratio from the capture viewport, so the
 *    space is the same size before, during and after a load. Nothing reflows
 *    when an image arrives late, and nothing collapses when none arrives.
 * 2. A placeholder sits behind the image at all times. It is geometry only,
 *    with no labels or data, so it reads as a frame waiting for a picture and
 *    never as a claim about a screen that does not exist.
 * 3. A failed image is removed from the box rather than left to render the
 *    browser's broken-image icon.
 *
 * Point 3 is progressive enhancement: the `data-shot-js` flag is set by an
 * inline head script, so the hide-until-loaded rule only applies where the
 * error handler can actually run. With scripting off the image shows the
 * moment it decodes instead of waiting for a handler that will never fire.
 */
import {
  SHOT_HEIGHT,
  SHOT_WIDTH,
  shotSrcset,
  shotUrl,
  type CapturedShotId,
  type Theme,
} from '~/lib/media';

interface Props {
  id: CapturedShotId;
  alt: string;
  /** Shown under the frame, and the figure's accessible name. */
  caption: string;
  /** The site is dark only. */
  theme?: Theme;
  /** Set on the first shot so it is not lazily deferred above the fold. */
  eager?: boolean;
}

const { id, alt, caption, theme = 'dark', eager = false } = Astro.props;
---

<figure class="shot" data-shot={id}>
  <div class="shot__frame">
    <!-- Geometry only. Decorative, so the image's alt text is the sole description. -->
    <div class="shot__placeholder" aria-hidden="true">
      <div class="shot__bar">
        <span class="shot__dot"></span>
        <span class="shot__dot"></span>
        <span class="shot__dot"></span>
      </div>
      <div class="shot__body">
        <div class="shot__rail"></div>
        <div class="shot__lines">
          <span class="shot__line"></span>
          <span class="shot__line"></span>
          <span class="shot__line"></span>
          <span class="shot__line"></span>
        </div>
      </div>
    </div>

    <img
      class="shot__img"
      src={shotUrl(id, theme, 1)}
      srcset={shotSrcset(id, theme)}
      width={SHOT_WIDTH}
      height={SHOT_HEIGHT}
      alt={alt}
      loading={eager ? 'eager' : 'lazy'}
      decoding="async"
      draggable="false"
    />
  </div>
  <figcaption class="shot__caption">{caption}</figcaption>
</figure>

<style>
  .shot {
    margin: 0;
  }

  /* The reserved box. Its height is a function of its width and the capture
     viewport, so it is identical whether or not an image ever loads. */
  .shot__frame {
    position: relative;
    aspect-ratio: 1440 / 900;
    width: 100%;
    overflow: hidden;
    border-radius: 0.875rem;
    border: 1px solid color-mix(in srgb, var(--canopy-blue, #00d4ff) 14%, transparent);
    background: var(--canopy-card, #111d2f);
    box-shadow: 0 1.5rem 3rem -1.5rem rgb(0 0 0 / 0.65);
  }

  .shot__placeholder {
    position: absolute;
    inset: 0;
    display: flex;
    flex-direction: column;
    background: linear-gradient(
      160deg,
      color-mix(in srgb, var(--canopy-card, #111d2f) 92%, transparent),
      var(--canopy-darker, #070f1a)
    );
  }

  .shot__bar {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.7rem 0.9rem;
    border-bottom: 1px solid rgb(255 255 255 / 0.06);
  }

  .shot__dot {
    width: 0.5rem;
    height: 0.5rem;
    border-radius: 50%;
    background: rgb(255 255 255 / 0.12);
  }

  .shot__body {
    flex: 1;
    display: flex;
    gap: 1.25rem;
    padding: 1.25rem;
    min-height: 0;
  }

  .shot__rail {
    width: 18%;
    border-radius: 0.5rem;
    background: rgb(255 255 255 / 0.04);
  }

  .shot__lines {
    flex: 1;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .shot__line {
    height: 1.5rem;
    border-radius: 0.375rem;
    background: rgb(255 255 255 / 0.04);
  }
  .shot__line:nth-child(2) {
    width: 86%;
  }
  .shot__line:nth-child(3) {
    width: 72%;
  }
  .shot__line:nth-child(4) {
    width: 64%;
  }

  .shot__img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: top center;
    transition: opacity 0.35s ease;
  }

  /* Only hide-until-loaded where the load and error handlers will run. */
  :global(html[data-shot-js]) .shot__img {
    opacity: 0;
  }
  :global(html[data-shot-js]) .shot[data-state='loaded'] .shot__img {
    opacity: 1;
  }
  /* Out of the box entirely, so the browser paints no broken-image icon. */
  :global(html[data-shot-js]) .shot[data-state='failed'] .shot__img {
    display: none;
  }

  @media (prefers-reduced-motion: reduce) {
    .shot__img {
      transition: none;
    }
  }

  .shot__caption {
    margin-top: 0.875rem;
    font-size: 0.8125rem;
    color: var(--canopy-text-muted, rgb(255 255 255 / 0.6));
  }
</style>

<script>
  /**
   * Resolve every shot to `loaded` or `failed`.
   *
   * An image can finish before this module runs, so each one is checked
   * synchronously first: a complete image with zero natural width is a load
   * that already failed, and waiting for an error event that has been and gone
   * would leave it stuck at the placeholder forever.
   */
  function settle(figure: HTMLElement, img: HTMLImageElement) {
    figure.dataset.state = img.naturalWidth > 0 ? 'loaded' : 'failed';
  }

  document.querySelectorAll<HTMLElement>('.shot').forEach((figure) => {
    const img = figure.querySelector<HTMLImageElement>('.shot__img');
    if (!img) return;

    if (img.complete) {
      settle(figure, img);
      return;
    }

    img.addEventListener('load', () => settle(figure, img), { once: true });
    img.addEventListener('error', () => {
      figure.dataset.state = 'failed';
    }, { once: true });
  });
</script>

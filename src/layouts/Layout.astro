---
import '../styles/global.css';
import { activeLogos } from '../lib/brand';

interface Props {
  title: string;
  description?: string;
  /** Absolute URL for og:image. Defaults to the hero poster. */
  ogImage?: string;
  ogType?: 'website' | 'article';
  /** Absolute canonical URL. Defaults to the current page. */
  canonical?: string;
}

const {
  title,
  description = 'Canopy - Growing the future of agriculture',
  ogImage = new URL('/hero/canopy-hero-poster.jpg', Astro.site).href,
  ogType = 'website',
  canonical = new URL(Astro.url.pathname, Astro.site).href,
} = Astro.props;

const orgJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: 'Canopy',
  url: Astro.site?.href,
  logo: new URL(activeLogos.full, Astro.site).href,
  sameAs: ['https://github.com/canopy-ag'],
};
---

<!DOCTYPE html>
<html lang="en" class="dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href={activeLogos.mono.favicon} />
    <meta name="description" content={description} />
    <title>{title}</title>
    <link rel="canonical" href={canonical} />
    <link rel="alternate" type="application/rss+xml" title="Canopy blog" href="/rss.xml" />
    <script is:inline type="application/ld+json" set:html={JSON.stringify(orgJsonLd)} />
    <meta property="og:site_name" content="Canopy" />
    <meta property="og:type" content={ogType} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:url" content={canonical} />
    <meta name="twitter:card" content="summary_large_image" />
    <slot name="head" />
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
  </head>
  <body class="text-white antialiased">
    <!-- Navigation -->
    <nav class="fixed top-0 left-0 right-0 z-50 glass">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="flex items-center justify-between h-16">
          <a href="/" class="flex items-center gap-3 group">
            <span class="brand-mark w-9 h-9 group-hover:scale-105 transition">
              <img src={activeLogos.badge} alt="Canopy" class="brand-mark-colour w-9 h-9" />
              <span
                class="brand-mark-mono w-9 h-9"
                role="img"
                aria-label="Canopy"
                style={`--brand-mono-mark: url('${activeLogos.mono.badge}')`}
              ></span>
            </span>
            <span class="text-lg font-bold tracking-wide gradient-text">CANOPY</span>
          </a>
          <div class="hidden md:flex items-center gap-8">
            <a href="/" class="nav-link text-white/70 hover:text-white transition">Home</a>
            <a href="/product" class="nav-link text-white/70 hover:text-white transition">Product</a>
            <a href="/blog" class="nav-link text-white/70 hover:text-white transition">Blog</a>
            <a href="/about" class="nav-link text-white/70 hover:text-white transition">About</a>
          </div>
          <a href="mailto:hello@canopy.ag" class="btn-secondary text-sm hidden sm:block">
            Get in Touch
          </a>
        </div>
      </div>
    </nav>
    
    <!-- Main content with padding for fixed nav -->
    <main class="pt-16">
      <slot />
    </main>
    
    <!-- Footer -->
    <footer class="border-t border-white/10 mt-24">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
        <div class="grid md:grid-cols-3 gap-8 mb-8">
          <div>
            <div class="flex items-center gap-2 mb-4">
              <span class="brand-mark w-7 h-7">
                <img src={activeLogos.badge} alt="Canopy" class="brand-mark-colour w-7 h-7" />
                <span
                  class="brand-mark-mono w-7 h-7"
                  role="img"
                  aria-label="Canopy"
                  style={`--brand-mono-mark: url('${activeLogos.mono.badge}')`}
                ></span>
              </span>
              <span class="font-bold gradient-text">CANOPY</span>
            </div>
            <p class="text-white/50 text-sm">
              Growing the future of agriculture through technology and data-driven insights.
            </p>
          </div>
          <div>
            <h4 class="font-semibold mb-4 text-white/80">Links</h4>
            <ul class="space-y-2 text-sm">
              <li><a href="/" class="text-white/50 hover:text-[#22C55E] transition">Home</a></li>
              <li><a href="/product" class="text-white/50 hover:text-[#22C55E] transition">Product</a></li>
              <li><a href="/blog" class="text-white/50 hover:text-[#22C55E] transition">Blog</a></li>
              <li><a href="/about" class="text-white/50 hover:text-[#22C55E] transition">About</a></li>
            </ul>
          </div>
          <div>
            <h4 class="font-semibold mb-4 text-white/80">Legal</h4>
            <ul class="space-y-2 text-sm">
              <li><a href="/privacy" class="text-white/50 hover:text-[#22C55E] transition">Privacy</a></li>
              <li><a href="/terms" class="text-white/50 hover:text-[#22C55E] transition">Terms</a></li>
              <li><a href="/support" class="text-white/50 hover:text-[#22C55E] transition">Support</a></li>
            </ul>
          </div>
          <div>
            <h4 class="font-semibold mb-4 text-white/80">Connect</h4>
            <ul class="space-y-2 text-sm">
              <li><a href="mailto:hello@canopy.ag" class="text-white/50 hover:text-[#22C55E] transition">hello@canopy.ag</a></li>
              <li><a href="https://github.com/canopy-ag" class="text-white/50 hover:text-[#22C55E] transition" rel="me">GitHub</a></li>
            </ul>
          </div>
        </div>
        <div class="pt-8 border-t border-white/10 text-center text-white/40 text-sm">
          <p>&copy; {new Date().getFullYear()} Canopy. All rights reserved.</p>
        </div>
      </div>
    </footer>
  </body>
</html>

<style is:global>
  /*
    roadmap#149. Two marks ship in the DOM and CSS picks one, so switching
    theme cannot flash: there is no JS swap path and no second network fetch.

    The colour mark is the default, which is exactly today's behaviour on a
    page with no `data-theme` attribute. canopy.ag does not set one yet
    (roadmap#148 introduces it), so this whole block stays inert until then
    and the site keeps rendering the colour mark as it does now.

    The mono mark is painted as a CSS mask rather than an `img`: an SVG loaded
    through `img` is its own document, so `currentColor` inside it would
    resolve against that document and not the page, and the mark would come
    out black on a black background. As a mask only the alpha matters, the
    paint comes from `background-color: currentColor`, and the mark therefore
    inherits the surrounding text colour: white on night, near black on light.
    The punched out leaf veins stay transparent and show the page through.
  */
  .brand-mark {
    display: inline-block;
    position: relative;
  }

  .brand-mark-mono {
    display: none;
    background-color: currentColor;
    -webkit-mask: var(--brand-mono-mark) center / contain no-repeat;
    mask: var(--brand-mono-mark) center / contain no-repeat;
  }

  :root[data-theme='night'] .brand-mark-colour,
  :root[data-theme='light'] .brand-mark-colour {
    display: none;
  }

  :root[data-theme='night'] .brand-mark-mono,
  :root[data-theme='light'] .brand-mark-mono {
    display: inline-block;
  }
</style>
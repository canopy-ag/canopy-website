---
import Layout from '~/layouts/Layout.astro';
import Hero from '~/components/Hero.astro';
import Section from '~/components/sections/Section.astro';
import FeatureGrid from '~/components/sections/FeatureGrid.astro';
import ProofBand from '~/components/sections/ProofBand.astro';
import CtaSection from '~/components/sections/CtaSection.astro';

const modules = [
  {
    tag: 'Live',
    tagTone: 'live' as const,
    title: 'Irrigation that runs itself',
    body: "Schedule to the crop's real demand, using local weather and your own input, so water and inputs feed the plant instead of the drain.",
    href: '/irrigation',
  },
  {
    tag: 'Early access',
    tagTone: 'soon' as const,
    title: 'Labor you can see before the day starts',
    body: 'A green and red morning report, in dollars, from your own numbers, so you know what needs you before the crews clock in.',
    href: '/labor',
  },
];

const operatingPoints = [
  {
    title: 'See what matters now',
    body: "Changing signals land in one place, so the day's priorities are clear before it starts.",
  },
  {
    title: 'Put labor where it counts',
    body: 'Your scarcest resource goes to the work that moves the operation, not to walking the yard.',
  },
  {
    title: 'Keep cost in view',
    body: 'Throughput and cost stay visible next to the work, in numbers you can take to the office.',
  },
];

const proof = [
  { value: '40+ years', label: 'Growing behind the product', body: 'Built by growers who have done the work, not a software team guessing.' },
  { value: 'UF research', label: 'The science underneath', body: 'Irrigation research from the University of Florida, proven in working nurseries.' },
  { value: 'Live beta', label: 'In the field now', body: 'Running today at Saunders Brothers and one more nursery.' },
];
---

<Layout
  title="Canopy | Connect every decision to the work that matters"
  description="Canopy is the operating layer for growers. Run irrigation, sensors, and labor from one system, so you can see what matters now, prioritize labor, and coordinate every shift."
>
  <!-- Hero: full-bleed nursery loop (src/components/Hero.astro; assets in public/hero). Kept as-is. -->
  <Hero />

  <Section
    eyebrow="What runs on Canopy"
    title="Start where it hurts. It all runs together."
    intro="Canopy is one operating layer for the whole operation. Begin with irrigation or labor, and everything you add works off the same plan, the same data, and the same screen."
  >
    <FeatureGrid items={modules} columns={2} />
  </Section>

  <Section
    eyebrow="One system"
    title="The operation runs on one plan, not three tools."
    intro="The real state of a growing operation lives in three places: a controller, a clipboard, and someone's head. Canopy brings them together, and works alongside the systems you already rely on."
    tone="panel"
  >
    <FeatureGrid items={operatingPoints} columns={3} />
  </Section>

  <Section
    eyebrow="Why growers trust it"
    title="Built by growers, proven in the field."
  >
    <ProofBand
      items={proof}
      note="Irrigation is live in beta today. Labor is in early access with our design partners. University of Florida figures reflect the research Canopy is built on, not results from Canopy's own controller."
    />
  </Section>

  <CtaSection
    title="See it on your operation."
    body="Book a demo and we will show you what Canopy looks like on your zones and your crews, starting wherever the pain is worst."
    demoLabel="Request a demo"
    secondaryHref="/labor"
    secondaryLabel="See the labor report"
  />
</Layout>

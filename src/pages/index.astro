---
/**
 * Home page. The hero is always on; every section below it is behind a
 * build-time flag in `src/lib/home-sections.ts`, so a section that is off is
 * not in the HTML at all.
 */
import Layout from '~/layouts/Layout.astro';
import Hero from '~/components/Hero.astro';
import LogoMarquee from '~/components/home/LogoMarquee.astro';
import HowItWorks from '~/components/home/HowItWorks.astro';
import ModuleCarousel from '~/components/home/ModuleCarousel.astro';
import ProofStrip from '~/components/home/ProofStrip.astro';
import Faq from '~/components/home/Faq.astro';
import FinalCta from '~/components/home/FinalCta.astro';
import { homeSections as on } from '~/lib/home-sections';

const showsShots = on['how-it-works'] || on.modules;
---

<Layout
  title="Canopy | Connect every decision to the work that matters"
  description="Canopy is building the operating layer that turns changing signals into clear labor priorities and coordinated work for growing operations."
>
  <Fragment slot="head">
    {
      showsShots && (
        <script is:inline>
          // ProductShot's hide-until-loaded rule; see that component and product.astro.
          document.documentElement.setAttribute('data-shot-js', '');
        </script>
      )
    }
  </Fragment>

  <!-- Hero: full-bleed nursery loop (src/components/Hero.astro; assets in public/hero) -->
  <Hero secondaryHref={on['how-it-works'] ? '#how-it-works' : '/about'} />

  {on.logos && <LogoMarquee />}
  {on['how-it-works'] && <HowItWorks />}
  {on.modules && <ModuleCarousel />}
  {on.proof && <ProofStrip showQuote={on.quote} />}
  {on.faq && <Faq />}
  {on.cta && <FinalCta />}
</Layout>
